<Window x:Class="EasySave.WPF.Views.CreateWorkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:EasySave.WPF.Helpers"
        Title="Nouveau travail"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Style="{StaticResource AppWindow}">

    <Window.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="16" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" Color="Black" Opacity="0.6" ShadowDepth="0" />
        </Border.Effect>
        <Grid Margin="32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding DataContext.LblDialogTitle, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='Nouveau travail'}"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="✕"
                        Command="{Binding CancelCommand}" />
            </Grid>

            <!-- Nom -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBlock Text="{Binding DataContext.LblFieldName, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='Nom'}"
                           FontSize="11" FontWeight="Bold" Margin="0,0,0,6"
                           Foreground="{StaticResource TextMutedBrush}" />
                <TextBox Style="{StaticResource ModernTextBox}"
                         Text="{Binding WorkName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- Source -->
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <TextBlock Text="{Binding DataContext.LblFieldSource, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='Source'}"
                           FontSize="11" FontWeight="Bold" Margin="0,0,0,6"
                           Foreground="{StaticResource TextMutedBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}"
                             Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                            Content="..." Margin="8,0,0,0" Padding="14,10"
                            Command="{Binding BrowseSourceCommand}" />
                </Grid>
            </StackPanel>

            <!-- Destination -->
            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <TextBlock Text="{Binding DataContext.LblFieldDestination, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='Destination'}"
                           FontSize="11" FontWeight="Bold" Margin="0,0,0,6"
                           Foreground="{StaticResource TextMutedBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}"
                             Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                            Content="..." Margin="8,0,0,0" Padding="14,10"
                            Command="{Binding BrowseDestinationCommand}" />
                </Grid>
            </StackPanel>

            <!-- Type -->
            <StackPanel Grid.Row="4" Margin="0,0,0,20">
                <TextBlock Text="{Binding DataContext.LblFieldType, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='Type'}"
                           FontSize="11" FontWeight="Bold" Margin="0,0,0,6"
                           Foreground="{StaticResource TextMutedBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <RadioButton Grid.Column="0" GroupName="Type"
                                 IsChecked="{Binding IsFullBackup, Mode=TwoWay}"
                                 Margin="0,0,6,0" Cursor="Hand">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bd"
                                        Background="{StaticResource SurfaceElevatedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="📦 Complet / Full"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Copie tous les fichiers"
                                                   FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentSoftBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <RadioButton Grid.Column="1" GroupName="Type"
                                 Margin="6,0,0,0" Cursor="Hand">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bd"
                                        Background="{StaticResource SurfaceElevatedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="🔁 Différentielle / Diff"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Copie seulement les fichiers modifiés"
                                                   FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SecondaryAccentBrush}" />
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentSoftBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </Grid>
            </StackPanel>

            <!-- Erreur -->
            <Border Grid.Row="5" Margin="0,0,0,16"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                    Background="#3B2330"
                    BorderBrush="{StaticResource ErrorBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" Foreground="{StaticResource ErrorBrush}"
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource ErrorBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Boutons -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}"
                        Content="{Binding DataContext.LblCancel, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='Annuler'}"
                        Command="{Binding CancelCommand}"
                        Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}"
                        Content="{Binding DataContext.LblSave, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue='Enregistrer'}"
                        Command="{Binding SaveCommand}" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
