<Window x:Class="EasySave.WPF.Views.CreateWorkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:EasySave.WPF.Helpers"
        Title="{Binding Tag.LblDialogTitle, RelativeSource={RelativeSource Self}, FallbackValue=EasySave v3}"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Style="{StaticResource AppWindow}">

    <Window.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolToVis" />
        <h:InverseBooleanConverter x:Key="InvBool" />
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="16" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" Color="Black" Opacity="0.6" ShadowDepth="0" />
        </Border.Effect>
        <Grid Margin="32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Tag.LblDialogTitle, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=EasySave}"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="✕"
                        Command="{Binding CancelCommand}" />
            </Grid>

            <!-- Nom -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBlock Text="{Binding Tag.LblFieldName, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Nom}"
                           FontSize="11" FontWeight="Bold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <TextBox Style="{StaticResource ModernTextBox}"
                         Text="{Binding WorkName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- Source -->
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <TextBlock Text="{Binding Tag.LblFieldSource, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Source}"
                           FontSize="11" FontWeight="Bold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}"
                             Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                            Content="{Binding Tag.LblBrowse, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=...}"
                            Margin="8,0,0,0" Padding="14,10"
                            Command="{Binding BrowseSourceCommand}" />
                </Grid>
            </StackPanel>

            <!-- Destination -->
            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <TextBlock Text="{Binding Tag.LblFieldDestination, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Destination}"
                           FontSize="11" FontWeight="Bold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}"
                             Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                            Content="{Binding Tag.LblBrowse, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=...}"
                            Margin="8,0,0,0" Padding="14,10"
                            Command="{Binding BrowseDestinationCommand}" />
                </Grid>
            </StackPanel>

            <!-- Type -->
            <StackPanel Grid.Row="4" Margin="0,0,0,20">
                <TextBlock Text="{Binding Tag.LblFieldType, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Type}"
                           FontSize="11" FontWeight="Bold" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <RadioButton Grid.Column="0" GroupName="Type"
                                 IsChecked="{Binding IsFullBackup, Mode=TwoWay}"
                                 Margin="0,0,6,0" Cursor="Hand">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bd"
                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Tag.LblBackupFullTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Tag.LblBackupFullDesc, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="11" Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <RadioButton Grid.Column="1" GroupName="Type"
                                 IsChecked="{Binding IsFullBackup, Converter={StaticResource InvBool}, Mode=TwoWay}"
                                 Margin="6,0,0,0" Cursor="Hand">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bd"
                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Tag.LblBackupDiffTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Tag.LblBackupDiffDesc, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="11" Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SecondaryAccentBrush}" />
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </Grid>
            </StackPanel>

            <!-- Erreur -->
            <Border Grid.Row="5" Margin="0,0,0,16"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                    Background="#3B2330"
                    BorderBrush="{DynamicResource ErrorBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" Foreground="{DynamicResource ErrorBrush}"
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource ErrorBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Boutons -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}"
                        Content="{Binding Tag.LblCancel, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Annuler}"
                        Command="{Binding CancelCommand}"
                        Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}"
                        Content="{Binding Tag.LblSave, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Enregistrer}"
                        Command="{Binding SaveCommand}" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
