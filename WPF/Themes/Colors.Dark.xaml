<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- EasySave v3 — thème sombre -->
    <Color x:Key="BackgroundColor">#0D0F18</Color>
    <Color x:Key="BackgroundAltColor">#12151F</Color>
    <Color x:Key="SurfaceColor">#1A1D2E</Color>
    <Color x:Key="SurfaceElevatedColor">#22263A</Color>
    <Color x:Key="SurfaceHoverColor">#2C3148</Color>
    <Color x:Key="BorderColor">#3D4466</Color>
    <Color x:Key="BorderGlowColor">#5B6BB8</Color>

    <Color x:Key="AccentColor">#6EE7FF</Color>
    <Color x:Key="AccentDarkColor">#38BDF8</Color>
    <Color x:Key="AccentSoftColor">#2A4A6E</Color>
    <Color x:Key="SecondaryAccentColor">#C4A5FD</Color>
    <Color x:Key="TertiaryAccentColor">#F472B6</Color>

    <Color x:Key="SuccessColor">#86EFAC</Color>
    <Color x:Key="WarningColor">#FCD34D</Color>
    <Color x:Key="ErrorColor">#FB7185</Color>

    <Color x:Key="TextPrimaryColor">#E8ECFF</Color>
    <Color x:Key="TextSecondaryColor">#A5B0D6</Color>
    <Color x:Key="TextMutedColor">#6B7394</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="BackgroundAltBrush" Color="{StaticResource BackgroundAltColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderGlowBrush" Color="{StaticResource BorderGlowColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource SecondaryAccentColor}" />
    <SolidColorBrush x:Key="TertiaryAccentBrush" Color="{StaticResource TertiaryAccentColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#141824" Offset="0" />
        <GradientStop Color="#0A0C12" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryButtonGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6EE7FF" Offset="0" />
        <GradientStop Color="#A78BFA" Offset="0.55" />
        <GradientStop Color="#F472B6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E2440" Offset="0" />
        <GradientStop Color="#2A1F4A" Offset="0.45" />
        <GradientStop Color="#163A52" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MainCanvasGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0D0F18" Offset="0" />
        <GradientStop Color="#101322" Offset="0.5" />
        <GradientStop Color="#0F1524" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentLineGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#6EE7FF" Offset="0" />
        <GradientStop Color="#C4A5FD" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="HeroOverlayBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="GlassFillBrush" Color="#18FFFFFF" />

</ResourceDictionary>
